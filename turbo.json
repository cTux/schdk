{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@schdk/desktop#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/electron/**"]
    },
    "package": {
      "dependsOn": ["build", "^build"],
      "cache": false,
      "env": ["GOOGLE_DESKTOP_CREDENTIALS_PATH"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {},
    "test": {
      "dependsOn": ["^build"]
    }
  }
}
