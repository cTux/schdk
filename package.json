{
  "name": "schdk",
  "private": true,
  "version": "0.1.0",
  "description": "Tools for creating and hosting Що? Де? Коли? game packages.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "25.x",
    "pnpm": "11.x"
  },
  "scripts": {
    "dev:host-web": "pnpm --filter @schdk/host-web-app dev",
    "dev:editor-web": "pnpm --filter @schdk/editor-web-app dev",
    "dev:host-desktop": "pnpm --filter @schdk/host-desktop-app dev",
    "dev:editor-desktop": "pnpm --filter @schdk/editor-desktop-app dev",
    "build": "turbo build && node scripts/collect-dist.mjs",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test"
  },
  "devDependencies": {
    "oxfmt": "^0.55.0",
    "turbo": "^2.9.18"
  }
}
