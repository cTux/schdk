{
  "name": "schdk",
  "private": true,
  "version": "0.1.0",
  "description": "Tools for creating and hosting Що? Де? Коли? game packages.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": "24.x",
    "pnpm": "11.x"
  },
  "scripts": {
    "dev": "pnpm --filter @schdk/web dev",
    "preview": "pnpm --filter @schdk/web preview",
    "storybook": "pnpm --filter @schdk/ui storybook",
    "dev:desktop": "pnpm --filter @schdk/desktop dev",
    "prepare": "git config core.hooksPath .githooks",
    "build": "turbo build package",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test && node --test scripts/repository-workflows.test.mjs",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "npm-check-updates": "^23.0.0",
    "oxfmt": "^0.61.0",
    "turbo": "^2.10.8"
  }
}
