{
  "name": "@schdk/google-drive",
  "version": "0.1.0",
  "description": "Shared Google Drive settings client for SCHDK.",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./ai-questions": {
      "types": "./src/services/ai-questions/ai-questions.ts",
      "development": "./src/services/ai-questions/ai-questions.ts",
      "default": "./dist/services/ai-questions/ai-questions.js"
    },
    "./game-packages": {
      "types": "./src/services/game-packages/game-packages.ts",
      "development": "./src/services/game-packages/game-packages.ts",
      "default": "./dist/services/game-packages/game-packages.js"
    },
    "./question-database": {
      "types": "./src/services/question-database/question-database.ts",
      "development": "./src/services/question-database/question-database.ts",
      "default": "./dist/services/question-database/question-database.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "oxlint -c ../../.oxlintrc.json src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "oxlint": "^1.76.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@schdk/common": "workspace:*"
  }
}
