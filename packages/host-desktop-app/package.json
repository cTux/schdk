{
  "name": "@schdk/host-desktop-app",
  "version": "0.1.0",
  "description": "Desktop game host.",
  "private": true,
  "type": "module",
  "main": "./dist/electron/main.js",
  "scripts": {
    "dev": "pnpm --filter @schdk/host-web-app build && pnpm build && electron .",
    "build": "tsc && electron-builder --dir",
    "lint": "oxlint -c ../../.oxlintrc.json electron",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@schdk/host-web-app": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "electron": "catalog:",
    "electron-builder": "catalog:",
    "oxlint": "^1.63.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "build": {
    "appId": "com.ctux.schdk.host",
    "productName": "SCHDK Host",
    "directories": {
      "output": "dist/release"
    },
    "files": [
      "dist/electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../host-web-app/dist",
        "to": "web"
      }
    ],
    "win": {
      "icon": "../editor-desktop-app/build/owl.png",
      "signExecutable": false,
      "target": "dir"
    }
  }
}
