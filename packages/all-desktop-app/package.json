{
  "name": "@schdk/all-desktop-app",
  "version": "0.1.0",
  "description": "Unified desktop app for SCHDK tools.",
  "private": true,
  "type": "module",
  "main": "./dist/electron/main.js",
  "scripts": {
    "dev": "pnpm --filter @schdk/all-web-app build && pnpm build && electron .",
    "build": "tsc",
    "prepackage": "node scripts/prepare-google-oauth-client.mjs",
    "package": "electron-builder --dir",
    "package:win": "node scripts/prepare-google-oauth-client.mjs && electron-builder --win --x64",
    "lint": "oxlint -c ../../.oxlintrc.json electron",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@schdk/ai": "workspace:*",
    "@schdk/all-web-app": "workspace:*",
    "@schdk/google-drive": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "electron": "catalog:",
    "electron-builder": "catalog:",
    "oxlint": "^1.75.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "build": {
    "appId": "com.ctux.schdk.all",
    "productName": "ЩДК",
    "directories": {
      "output": "dist/release"
    },
    "files": [
      "dist/electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../all-web-app/dist",
        "to": "web"
      },
      {
        "from": "build/google-oauth-client.json",
        "to": "google-oauth-client.json"
      }
    ],
    "win": {
      "icon": "build/owl.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "schdk-${version}-windows-${arch}-installer.${ext}"
    },
    "portable": {
      "artifactName": "schdk-${version}-windows-${arch}-portable.${ext}"
    }
  }
}
