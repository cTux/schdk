{
  "name": "@schdk/all-web-app",
  "version": "0.1.0",
  "description": "Unified browser shell for SCHDK tools.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "oxlint -c ../../.oxlintrc.json src vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@schdk/editor-web-app": "workspace:*",
    "@schdk/host-web-app": "workspace:*",
    "@schdk/ui": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "oxlint": "^1.75.0",
    "sass": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
