{
  "name": "@schdk/ui",
  "version": "0.1.0",
  "description": "Shared SCHDK UI components, assets, and design rules.",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./editor": "./src/editor/EditorView/index.ts",
    "./host": "./src/host/HostView/index.ts",
    "./localization": "./src/localization/index.ts",
    "./options": "./src/options/types.ts",
    "./shell": "./src/shell/ShellView/index.ts"
  },
  "scripts": {
    "build": "vite build",
    "build:storybook": "pnpm --filter @schdk/common build && pnpm storybook:generate && tsc -p tsconfig.storybook.json && storybook build -o dist/storybook",
    "lint": "oxlint -c ../../.oxlintrc.json src vite.config.ts && stylelint \"src/**/*.scss\"",
    "storybook": "pnpm --filter @schdk/common build && pnpm storybook:generate && storybook dev -p 6006",
    "storybook:generate": "node .storybook/generate-stories.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@schdk/common": "workspace:*",
    "classnames": "^2.5.1",
    "react": "catalog:"
  },
  "devDependencies": {
    "@storybook/addon-docs": "10.5.5",
    "@storybook/react-vite": "10.5.5",
    "@types/react": "catalog:",
    "oxlint": "^1.75.0",
    "react-dom": "catalog:",
    "sass": "catalog:",
    "storybook": "10.5.5",
    "stylelint": "catalog:",
    "stylelint-config-standard-scss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
