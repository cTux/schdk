{
  "name": "@schdk/common",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./ai-question": {
      "types": "./src/contracts/ai-questions/ai-question.ts",
      "development": "./src/contracts/ai-questions/ai-question.ts",
      "default": "./dist/contracts/ai-questions/ai-question.js"
    },
    "./ai-question-package": {
      "types": "./src/contracts/ai-questions/ai-questions-package.ts",
      "development": "./src/contracts/ai-questions/ai-questions-package.ts",
      "default": "./dist/contracts/ai-questions/ai-questions-package.js"
    },
    "./game-question": {
      "types": "./src/contracts/game-questions/game-question.ts",
      "development": "./src/contracts/game-questions/game-question.ts",
      "default": "./dist/contracts/game-questions/game-question.js"
    },
    "./visual-editor-template": {
      "types": "./src/contracts/game-options/visual-editor-template.ts",
      "development": "./src/contracts/game-options/visual-editor-template.ts",
      "default": "./dist/contracts/game-options/visual-editor-template.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "oxlint -c ../../.oxlintrc.json src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "oxlint": "^1.76.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  }
}
